TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID. Exactly one owner is supported.
OWNER_TELEGRAM_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Created interactively with python -m eventradar.session; never a bot session.
TELEGRAM_READER_SESSION=
# OAuth credentials live on a writable volume, never in an API key variable.
CHATGPT_AUTH_DIR=/data/chatgpt
# Optional slug from: python -m eventradar.chatgpt_auth models
# Empty selects the first visible model offered by your account.
CHATGPT_MODEL=
DEFAULT_TIMEZONE=Europe/Moscow
SOURCE_TIMEZONE=Europe/Moscow
DATABASE_PATH=/data/eventradar.sqlite3
INITIAL_LOOKBACK_DAYS=7
MAX_CHANNELS_PER_USER=30
MAX_AI_CALLS_PER_DAY=300
AI_BATCH_SIZE=10
AI_BATCH_MAX_CHARACTERS=30000
# Illustration limit only; never limits event cards. 0 disables photos.
MAX_PHOTOS_PER_REPORT=3
