TELEGRAM_BOT_TOKEN=
# Numeric Telegram IDs, comma-separated. Access is closed if empty.
ALLOWED_USER_IDS=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Created interactively with python -m eventradar.session; never a bot session.
TELEGRAM_READER_SESSION=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DEFAULT_TIMEZONE=Europe/Moscow
SOURCE_TIMEZONE=Europe/Moscow
DATABASE_PATH=/data/eventradar.sqlite3
POLL_INTERVAL_SECONDS=300
INITIAL_LOOKBACK_DAYS=7
MAX_CHANNELS_PER_USER=30
MAX_AI_CALLS_PER_DAY=300
MAX_POSTS_PER_CYCLE=100
MAX_DIGEST_ITEMS=20
# Optional. No address is sent to Google unless /routing on is selected.
GOOGLE_ROUTES_API_KEY=
